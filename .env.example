# ============================================================
#  TEMPLATE — salin jadi ".env" lalu isi nilainya.
#  File ".env" TIDAK di-commit (lihat .gitignore).
#
#     Copy-Item .env.example .env
#
#  File ".env" dibaca otomatis oleh `docker compose` di folder ini.
#  Nama variabel di sini SAMA PERSIS dengan yang dipakai docker-compose.yml.
# ============================================================

# ---------- Port host ----------
PORT_BACKEND=5006
PORT_FRONTEND=3007

# ---------- CORS (origin yang boleh memanggil API dari browser) ----------
# Pisahkan dengan koma bila lebih dari satu. localhost untuk uji lokal.
CORS_ORIGIN=https://jendela-kinerja.bbpompky.id,http://localhost:3007

# ---------- Database MySQL ----------
# MySQL DI LUAR Docker (bukan container).
# Backend memakai network_mode: "host", jadi 127.0.0.1 di dalam container
# = server itu sendiri. MySQL TIDAK perlu dibuka ke jaringan.
#   MySQL di server yang sama, di luar Docker -> 127.0.0.1  <== paling umum
#   MySQL di komputer lain di LAN             -> IP komputer itu
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jendelakinerja
DB_PASSWORD=ISI_PASSWORD_MYSQL
DB_NAME=jendelakinerja

# ---------- Keycloak ----------
KEYCLOAK_SERVER_URL=https://auth.bbpompky.id
KEYCLOAK_REALM=master
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=ISI_PASSWORD_ADMIN_KEYCLOAK
# Client yang dipakai backend DAN frontend.
KEYCLOAK_CLIENT_ID=jendela
# Keycloak -> Clients -> <client> -> Credentials
KEYCLOAK_CLIENT_SECRET=ISI_CLIENT_SECRET_KEYCLOAK
# Issuer dipakai frontend (NextAuth) dan backend (verifikasi token).
KEYCLOAK_ISSUER=https://auth.bbpompky.id/realms/master

# ---------- Integrasi LAURA / TALAWANG (opsional) ----------
# Alamat API LAURA yang dipanggil PROXY /api/laura. Harus alamat dasar API
# (proxy menambahkan "/public/<rute>"), umumnya berakhiran "/api".
laura_API_URL=https://data-laura.bbpompky.id/api

# ---------- Cetak PDF di server (Chrome headless) ----------
# Kosongkan bila ingin dicari otomatis.
CHROME_PATH=

# ---------- Frontend (Next.js) ----------
# PENTING: NEXT_PUBLIC_* ter-BAKE saat image di-build, jadi salah isi di sini
# = URL salah ikut tertanam di image (perlu build ulang untuk mengubahnya).
# Ini alamat API PUBLIK (untuk browser); proxy server memakai jalur internal
# (http://host.docker.internal:PORT_BACKEND/api, diatur docker-compose.yml).
NEXT_PUBLIC_API_URL=https://data-jendela.bbpompky.id/api

# NEXTAUTH_URL HARUS sama dengan alamat yang dibuka di browser.
NEXTAUTH_URL=https://jendela-kinerja.bbpompky.id
# Buat nilai acak:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=ISI_RANDOM_32_BYTE_BASE64