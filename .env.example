# ============================================================
#  TEMPLATE — salin jadi ".env" lalu isi nilainya.
#  File ".env" TIDAK di-commit (lihat .gitignore).
#
#     Copy-Item .env.example .env
#
#  File ".env" dibaca otomatis oleh `docker compose` di folder ini.
#
#  Daftar di bawah = SELURUH variabel yang dibaca docker-compose.yml
#  (27 kunci). Compose TIDAK punya nilai bawaan lagi, jadi jangan hapus
#  atau mengosongkan kunci yang ditandai WAJIB.
# ============================================================

# ---------- URL publik ----------
# WEB_URL = alamat web -> NEXTAUTH_URL (frontend) + CORS_ORIGIN (backend)
# API_URL = alamat API -> NEXT_PUBLIC_API_URL (build frontend) + PUBLIC_BASE_URL (backend)
# WAJIB.
WEB_URL=https://lets-xx.bbpompky.id
API_URL=https://xx-lets.bbpompky.id/api

# ---------- Alamat backend untuk PROXY (server-side) ----------
# Opsional. Kosong = proxy di pages/api/** memakai NEXT_PUBLIC_API_URL.
# Bila domain API publik belum dirutekan, frontend bisa memanggil backend
# langsung lewat alamat internal:
#   BACKEND_API_URL=http://host.docker.internal:5006/api
# Syarat: backend mendengar di semua antarmuka -> BACKEND_HOST=0.0.0.0
# (bawaan 127.0.0.1 tidak terjangkau dari container frontend).
BACKEND_API_URL=

# ---------- Port & host ----------
# Dipakai apa adanya oleh compose (tanpa nilai bawaan).
BACKEND_PORT=5006
# 127.0.0.1 = hanya server ini (aman, untuk reverse proxy lokal).
# Hanya isi 0.0.0.0 bila backend memang harus diakses dari perangkat lain.
BACKEND_HOST=127.0.0.1
FRONTEND_PORT=3007
# Awalan nama cookie sesi NextAuth (hindari bentrok antar aplikasi di host sama).
AUTH_COOKIE_PREFIX=jk

# ---------- Database MySQL ----------
# MySQL DI LUAR Docker (bukan container).
# Backend memakai network_mode: "host", jadi 127.0.0.1 di dalam container
# = server itu sendiri. MySQL TIDAK perlu dibuka ke jaringan.
#   MySQL di server yang sama, di luar Docker -> 127.0.0.1  <== paling umum
#   MySQL di komputer lain di LAN             -> IP komputer itu
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jendela_app
# WAJIB.
DB_PASSWORD=ISI_PASSWORD_MYSQL
DB_NAME=jendelakinerja

# ---------- Keycloak ----------
# Dipakai backend DAN frontend (client yang sama).
KEYCLOAK_SERVER_URL=https://auth.bbpompky.id
KEYCLOAK_REALM=master
# Sesuaikan dengan nama client di Keycloak: Clients -> <client>.
KEYCLOAK_CLIENT_ID=ISI_CLIENT_ID_KEYCLOAK
# WAJIB. Keycloak -> Clients -> <client> -> Credentials.
KEYCLOAK_CLIENT_SECRET=ISI_CLIENT_SECRET_KEYCLOAK
# Admin Keycloak (dipakai backend membaca daftar user via Admin REST API).
KEYCLOAK_ADMIN_USERNAME=admin
# WAJIB.
KEYCLOAK_ADMIN_PASSWORD=ISI_PASSWORD_ADMIN_KEYCLOAK

# ---------- NextAuth ----------
# NEXTAUTH_URL otomatis memakai WEB_URL (lihat docker-compose.yml).
# Buat nilai acak untuk secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# WAJIB.
NEXTAUTH_SECRET=ISI_RANDOM_32_BYTE_BASE64

# ---------- Rahasia aplikasi backend ----------
# Dipakai backend untuk menyegel token di tabel api_link (AES-256-GCM).
# WAJIB diisi; kalau berubah setelah ada link dibuat, link lama tidak bisa
# dibuka lagi.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=ISI_RANDOM_32_BYTE_BASE64
# Opsional. Bila kosong, backend memakai SESSION_SECRET.
API_LINK_SECRET=

# ---------- Keamanan token (bawaan sudah aman) ----------
AUTH_VERIFIKASI=aktif
AUTH_PERIKSA_ISSUER=aktif
AUTH_AUDIENCE=
PERAN_TULIS=admin,superadmin,admin_*

# ---------- Integrasi LAURA (opsional) ----------
# Alamat publik widget LAURA di browser (ditanam saat build frontend).
LAURA_URL=https://laura-ai.bbpompky.id
# Alamat API LAURA dipanggil server-side (boleh alamat internal di LAN).
LAURA_API_URL=
