# ============================================================
#  TEMPLATE — salin jadi ".env" (TIDAK di-commit)
#
#     Copy-Item .env.example .env
#
#  Dipakai oleh `node server.js` maupun container backend.
#  Nilai di bawah ini contoh untuk LOCAL DEV (backend 5006, frontend 3007).
# ============================================================

# ---------- Server ----------
PORT=5006
NODE_ENV=development

# ---------- Keycloak ----------
KEYCLOAK_SERVER_URL=https://auth.bbpompky.id
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=local-pengujian
# Keycloak -> Clients -> <client> -> Credentials
KEYCLOAK_CLIENT_SECRET=ISI_CLIENT_SECRET_KEYCLOAK

# Admin Keycloak (dipakai routes/keycloak.js -> Admin REST API)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=ISI_PASSWORD_ADMIN_KEYCLOAK

# ---------- CORS ----------
CORS_ORIGIN=http://localhost:3007

# ---------- Database MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jendela_app
DB_PASSWORD=9dDd4kA8Wmjf3272OO3o_GAK
DB_NAME=jendelakinerja

# ---------- Security ----------
# Buat nilai acak: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=ISI_RANDOM_32_BYTE_BASE64
SESSION_SECRET=ISI_RANDOM_32_BYTE_BASE64

# ---------- Opsional ----------
# DATA_PATH=./data
# UPLOADS_PATH=./uploads

# ---------- KEAMANAN API (hasil perbaikan laporan pentest 24 Nov 2026) ----------
# AUTH_VERIFIKASI: 'aktif' = tanda tangan token diperiksa lewat JWKS Keycloak
# (WAJIB). 'nonaktif' hanya untuk pengembangan tanpa jaringan — token TIDAK
# diperiksa sehingga siapa pun bisa menulis data.
AUTH_VERIFIKASI=aktif
# Periksa klaim issuer token. Matikan hanya bila issuer berbeda dari JWKS.
AUTH_PERIKSA_ISSUER=aktif
# Peran Keycloak yang boleh mengubah data (impor/hapus). Pisahkan dengan koma.
# Sesuaikan dengan peran petugas pengelola data di realm Anda.
PERAN_TULIS=admin,superadmin,admin_*
# Alamat dengar backend. 127.0.0.1 = hanya komputer ini (aman).
# Set 0.0.0.0 hanya bila memang harus diakses dari perangkat lain.
HOST=127.0.0.1
